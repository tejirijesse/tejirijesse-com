---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Clause 10. Full-bleed image plus three-line label. The entire block is one
 * link. On hover the label underline appears and the image does not move,
 * scale or dim — rule 04.2 treats these as five things, not a grid of tiles,
 * and a hover transform is what makes a thing read as a tile.
 *
 * `eager` is set on the first frame only, per clause 13.
 */
interface Props {
  href: string;
  image: ImageMetadata;
  alt: string;
  caption: string;
  name: string;
  oneLine: string;
  sector: string;
  years: string;
  status: 'live' | 'pilot' | 'paused' | 'closed';
  eager?: boolean;
}
const { href, image, alt, caption, name, oneLine, sector, years, status, eager = false } =
  Astro.props;
---

<a class="frame" href={href}>
  <figure class="shot">
    <Picture
      src={image}
      alt={alt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[640, 900, 1280, 1920, 2560]}
      sizes="100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding={eager ? 'sync' : 'async'}
      data-fade={eager ? undefined : ''}
    />
  </figure>

  <div class="wrap">
    <div class="label">
      <h2 class="name">{name}</h2>
      <span class="one-line">{oneLine}</span>
      <span class="meta">
        {sector} <span aria-hidden="true">·</span> {years}
        <span aria-hidden="true">·</span> {status}
      </span>
    </div>
    <p class="caption index-caption">{caption}</p>
  </div>
</a>

<style>
  .frame {
    display: block;
  }

  /* The frame anchor is a child of <main>, which is already the full width of
     the document, so this needs no bleed escape — only to fill what it has. */
  .shot {
    margin: 0;
    width: 100%;
  }

  .label {
    margin-top: var(--s3);
    max-width: var(--measure);
    display: grid;
    gap: var(--s1);
  }

  .name {
    margin: 0;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 500;
    /* The underline is the whole hover state. */
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-color 120ms ease-out;
  }

  .one-line {
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }

  .frame:hover .name,
  .frame:focus-visible .name {
    text-decoration-color: var(--accent);
  }

  .index-caption {
    margin-top: var(--s2);
  }

  @media (prefers-reduced-motion: reduce) {
    .name {
      transition: none;
    }
  }
</style>
