---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Clause 10 and rule 05.4. Poster frame, click to play, muted, playsinline,
 * no autoplay, no loop, no background video.
 *
 * Nothing loads until the reader clicks: the poster is a static image and the
 * iframe is written on click. Clause 13 requires a privacy-mode embed rather
 * than a self-hosted file, and clause 14 forbids third-party scripts, so the
 * provider frame is only ever constructed after a deliberate action.
 *
 * Rule 05.4 says the page must be complete with the video removed, which is
 * why `summary` is required: the argument the film makes has to exist in
 * prose whether or not anyone presses play. Clause 12 needs it too.
 */
interface Props {
  src: string;
  poster: ImageMetadata;
  posterAlt: string;
  credit: string;
  runtime: string;
  title: string;
}
const { src, poster, posterAlt, credit, runtime, title } = Astro.props;

const url = new URL(src);
const privacyHosts = ['www.youtube-nocookie.com', 'player.vimeo.com'];
if (!privacyHosts.includes(url.host)) {
  throw new Error(
    `Clause 13: film embeds must use a privacy-mode host (${privacyHosts.join(', ')}). Got ${url.host}.`
  );
}
url.searchParams.set('autoplay', '1');
url.searchParams.set('muted', '1');
url.searchParams.set('playsinline', '1');
url.searchParams.set('rel', '0');
---

<figure class="film">
  <div class="stage" data-film={url.toString()} data-title={title}>
    <Picture
      src={poster}
      alt={posterAlt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[640, 900, 1280, 1920]}
      sizes="(min-width: 1080px) 1032px, 100vw"
      loading="lazy"
      decoding="async"
    />
    <button type="button" class="play">
      Play film <span class="meta runtime">{runtime}</span>
    </button>
  </div>
  <figcaption class="caption">{credit} · {runtime}</figcaption>
</figure>

<script>
  // The only script on the site. It replaces a poster with a provider frame
  // after a click, so a reader who never presses play never loads a third
  // party. Nothing on the page depends on this running.
  document.querySelectorAll<HTMLElement>('.stage[data-film]').forEach((stage) => {
    stage.querySelector('button')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = stage.dataset.film!;
      frame.title = stage.dataset.title!;
      frame.allow = 'autoplay; fullscreen; picture-in-picture';
      frame.setAttribute('allowfullscreen', '');
      frame.loading = 'lazy';
      stage.replaceChildren(frame);
    });
  });
</script>

<style>
  .film {
    margin: var(--s5) 0;
    max-width: var(--measure);
  }

  .stage {
    position: relative;
    background: var(--surface);
    aspect-ratio: 16 / 9;
  }

  .stage :global(img),
  .stage :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }

  .play {
    position: absolute;
    left: var(--s3);
    bottom: var(--s3);
    display: inline-flex;
    align-items: baseline;
    gap: var(--s1);
    padding: var(--s2) var(--s3);
    font-family: var(--sans);
    font-size: 17px;
    color: var(--ink);
    background: var(--ground);
    border: 1px solid var(--rule);
    cursor: pointer;
  }

  .runtime {
    color: var(--muted);
  }
</style>
